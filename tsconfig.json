{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// 全パッケージとテストをまとめて検査する。環境の制限は各パッケージの tsconfig でかける
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["bun"]
	},
	"include": [
		"packages/*/src",
		"packages/backend/integration",
		"packages/frontend/integration",
		"packages/*/vite.config.ts",
		"packages/*/drizzle.config.ts",
		"packages/*/playwright.config.ts",
		"scripts"
	]
}
