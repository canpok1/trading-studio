{
	"name": "trading-studio",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --parallel --filter '@trading-studio/backend' --filter '@trading-studio/frontend' dev",
		"build": "bun run --filter '@trading-studio/frontend' build",
		"start": "bun run --filter '@trading-studio/backend' start",
		"db:generate": "bun run --filter '@trading-studio/backend' db:generate",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc -p . && bun run --filter '*' typecheck",
		"test": "bun test --pass-with-no-tests",
		"test:small": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.medium.test.*'",
		"test:medium": "bun test --pass-with-no-tests .medium.test",
		"depcruise": "depcruise packages",
		"layers": "bun scripts/check-backend-layers.ts",
		"check": "bun run lint && bun run typecheck && bun run test && bun run depcruise && bun run layers",
		"test:e2e": "bun run build && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@swc/core": "^1.16.2",
		"@types/bun": "^1.4.2",
		"dependency-cruiser": "^18.4.0",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.11"
}
