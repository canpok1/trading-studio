{
	"name": "trading-studio",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc -p . && bun run --filter '*' typecheck",
		"test": "bun test --pass-with-no-tests",
		"depcruise": "depcruise packages",
		"check": "bun run lint && bun run typecheck && bun run test && bun run depcruise"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"dependency-cruiser": "^18.4.0",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.11"
}
